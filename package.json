{
  "name": "@router-for-me/dsh-cliproxyapi-provider",
  "version": "0.0.3",
  "description": "GUI-configurable CLIProxyAPI Responses provider for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./catalog": "./src/catalog.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/catalog.js && node --check client.js && node --test",
    "pack:github": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayanjimmy/dsh-cliproxyapi-provider.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.3 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-authorization": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
